# Copier ce fichier en .env et adapter. Ne jamais versionner de secret réel.

# Base de données
#  - Développement / démo sans serveur : PGlite embarqué, persisté sur disque
#      DATABASE_URL=pglite:./.data/pglite
#  - Production : PostgreSQL serveur
#      DATABASE_URL=postgres://utilisateur:motdepasse@hote:5432/gestion?sslmode=require
DATABASE_URL=pglite:./.data/pglite

# Environnement applicatif : development | production
# En production, les cookies de session sont marqués Secure (HTTPS obligatoire).
APP_ENV=development

# URL publique de l'application (sert à la vérification d'origine des requêtes).
APP_URL=http://localhost:3000

# Durée de vie d'une session, en heures.
SESSION_TTL_HOURS=12

# Autoriser la création de compte en libre-service (true en dev, false recommandé en production).
ALLOW_SELF_SIGNUP=true

# Clé Ed25519 (PKCS#8 PEM, « 
 » échappés) de signature des clôtures et archives de caisse.
# Obligatoire en production (npm run cash:keygen). En développement, une clé est créée
# automatiquement dans .data/keys/cash-signing.pem.
# CASH_SIGNING_KEY=

# Clé AES-256 (32 octets en base64) de chiffrement des secrets de double authentification.
# Obligatoire en production (npm run cash:keygen) ; en développement, créée dans .data/keys/.
# APP_ENCRYPTION_KEY=

# Répertoire des pièces jointes (défaut : .data/attachments). En production : volume persistant sauvegardé.
# ATTACHMENTS_DIR=

# Envoi d'e-mails (relances) : outbox (dépôt de fichiers .eml dans EMAIL_OUTBOX_DIR, défaut en développement)
# ou none (défaut en production : envoi désactivé). Le service réel (SMTP, API) reste à choisir.
# EMAIL_TRANSPORT=outbox
# EMAIL_FROM=facturation@exemple.fr
# EMAIL_OUTBOX_DIR=
